# Copy to .env. Environment variables win over this file; this file wins over
# config.json. Every value is optional.

# github.com, or a GitHub Enterprise host such as your-tenant.ghe.com
COPILOT_DOMAIN=github.com

# Where the long-lived OAuth token is read from. Default:
# $XDG_CONFIG_HOME/copilot-proxy/oauth.txt (usually ~/.config/copilot-proxy/oauth.txt)
# COPILOT_OAUTH_FILE=/absolute/path/to/oauth.txt

PORT=8787

# Loopback by default. Use 0.0.0.0 only if a container must reach the proxy:
# it holds a credential and has no authentication of its own.
BIND=127.0.0.1

# Debug tap. Writes every upstream request body, including prompt content,
# to disk in the clear. Leave unset unless you are actively debugging.
# PROXY_DUMP_DIR=/tmp/copilot-proxy-dump
