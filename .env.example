# Non-secret settings only. Flags override these values.
COPILOT_DOMAIN=github.com
# Required for keyring mode; omit for memory-only sessions.
# COPILOT_ACCOUNT=YOUR_GITHUB_LOGIN
PORT=8787
BIND=127.0.0.1

# Debug only: writes prompts to disk in plaintext. Leave unset normally.
# PROXY_DUMP_DIR=/absolute/path/to/debug-output
