# Non-secret settings only. Flags override these values.
COPILOT_DOMAIN=github.com

# Where the long-lived OAuth token is kept: keyring | memory | file.
COPILOT_AUTH=keyring
# Required for keyring mode; omit for memory-only sessions.
# COPILOT_ACCOUNT=YOUR_GITHUB_LOGIN
# Used only by COPILOT_AUTH=file. Created mode 0600.
# COPILOT_OAUTH_FILE=/absolute/path/to/oauth.txt

PORT=8787
BIND=127.0.0.1

# Safe to leave on: shape and counts per request, never prompt text or tokens.
# PROXY_REQUEST_LOG=/absolute/path/to/requests.ndjson

# Debug only: writes prompts to disk in plaintext. Leave unset normally.
# PROXY_DUMP_DIR=/absolute/path/to/debug-output
