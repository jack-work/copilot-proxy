[Unit]
Description=Copilot inference proxy (Anthropic Messages API on :8787)
After=network.target

[Service]
Type=simple
# Adjust to wherever you cloned this. %h is your home directory.
WorkingDirectory=%h/.local/share/copilot-proxy
ExecStart=/usr/bin/env python3 -u proxy.py
Restart=always
RestartSec=2

# Uncomment to reach the proxy from containers (Docker's host.docker.internal).
# Read the README first: this proxy holds a credential and has no auth of its own.
# Environment=BIND=0.0.0.0

# Uncomment to dump every upstream request body to disk for debugging.
# This writes prompt content in the clear.
# Environment=PROXY_DUMP_DIR=%T/copilot-proxy-dump

[Install]
WantedBy=default.target
